# ─── MercadoPago ─────────────────────────────────────────────────────────────
# Obtenha em: https://www.mercadopago.com.br/developers/panel/credentials
# Em teste: começa com TEST-   |   Em produção: começa com APP_USR-
MERCADO_PAGO_ACCESS_TOKEN=TEST-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── URLs ────────────────────────────────────────────────────────────────────
# URL do seu frontend (sem barra no final)
# Local:      http://localhost:5173
# Produção:   https://sportfyfatec.netlify.app
FRONTEND_URL=http://localhost:5173

# URL pública do backend (usada para o webhook do MercadoPago)
# Só necessário em produção — em desenvolvimento pode deixar vazio
# Exemplo:    https://seu-backend.railway.app
BACKEND_URL=

# ─── Servidor ────────────────────────────────────────────────────────────────
PORT=3001
